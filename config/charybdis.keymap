#include <behaviors/mouse_keys.dtsi>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/ext_power.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/mouse.h>
#include <dt-bindings/zmk/pointing.h>
#include <dt-bindings/zmk/input_transform.h>
#include <input/processors.dtsi>

// Layer definitions
// 0: BASE    - QWERTY, same as the other keyboard (thumbs: L Alt/Space/Gui + MO1/Alt, R Ctrl/Enter + MO4)
// 1: FN      - arrows, nav, media + trackball scroll (hold left lower thumb)
// 2: BT      - bluetooth management
// 3: SCROLL  - trackball scroll
// 4: FKEYS   - F1-F12 (hold right lower thumb)
// 5: GAME    - gaming mode (toggle: Space + Enter together; K/M/,/. as arrows)
// 6: MOUSE   - auto mouse layer: turned on by moving the trackball, off 700 ms after it stops

/ {
    behaviors {
        lspc: left_space_scroll {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            flavor = "tap-preferred";
            bindings = <&mo>, <&kp>;
        };
    };

    /* Trackball (standard ZMK input listener; replaces badjeff's input-behavior-listener,
       whose main branch no longer builds with ZMK v0.3).
       - base: cursor move, scaled 13/20 (was 1/2, +30%), both axes inverted
       - moving the ball turns on the MOUSE layer, it switches off 700 ms after the ball stops
       - on FN (hold left space) and SCROLL layers the ball scrolls vertically */

    trackball_listener {
        compatible = "zmk,input-listener";
        device = <&vtrackball>;
        input-processors = <&zip_xy_scaler 13 20>,   /* 0.65 = 1/2 + 30% */
                           <&zip_xy_transform (INPUT_TRANSFORM_X_INVERT | INPUT_TRANSFORM_Y_INVERT)>,
                           <&zip_temp_layer 6 700>;

        scroller {
            layers = <1 3>;
            input-processors = <&zip_xy_transform (INPUT_TRANSFORM_Y_INVERT)>,
                               <&zip_x_scaler 0 1>,
                               <&zip_xy_scaler 1 14>,
                               <&zip_xy_to_scroll_mapper>;
        };
    };

    combos {
        compatible = "zmk,combos";

        to-BT {
            bindings = <&mo 2>;
            key-positions = <41 42>;
            layers = <0 1>;
        };

        game_toggle {
            bindings = <&tog 5>;
            key-positions = <49 52>;
            layers = <0 5>;
            timeout-ms = <100>;
        };

    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            label = "BASE";
            bindings = <
&kp ESCAPE  &kp N1  &kp N2  &kp N3    &kp N4     &kp N5       &kp N6     &kp N7     &kp N8     &kp N9    &kp N0    &kp BSPC
&kp TAB     &kp Q   &kp W   &kp E     &kp R      &kp T        &kp Y      &kp U      &kp I      &kp O     &kp P     &kp LBKT
&kp LSHFT   &kp A   &kp S   &kp D     &kp F      &kp G        &kp H      &kp J      &kp K      &kp L     &kp SEMI  &kp SQT
&kp LCTRL   &kp Z   &kp X   &kp C     &kp V      &kp B        &kp N      &kp M      &kp COMMA  &kp DOT   &kp FSLH  &kp RSHFT
                             &kp LALT  &kp SPACE  &kp LGUI     &kp LCTRL  &kp RET
                                       &mo 1      &kp LALT     &mo 4
            >;
        };

        fn_layer {
            label = "FN";
            bindings = <
&kp GRAVE  &trans      &trans        &trans        &trans  &trans     &trans    &trans     &trans     &kp LBKT   &kp RBKT   &kp DEL
&kp CAPS   &kp C_MUTE  &kp C_VOL_DN  &kp C_VOL_UP  &kp C_PREV  &kp C_NEXT    &trans    &kp INS    &kp PSCRN  &kp MINUS  &kp EQUAL  &kp DEL
&kp LCTRL  &trans      &mkp MB4      &mkp MB5      &kp C_PP  &trans    &kp LEFT  &kp DOWN  &kp UP     &kp RIGHT  &kp HOME   &kp END
&kp LSHFT  &trans      &trans        &trans        &trans  &trans     &trans    &trans    &trans     &trans     &trans     &trans
                            &kp LALT  &kp SPACE  &trans        &trans    &trans
                                      &trans     &trans        &kp DEL
            >;
        };

        bt_layer {
            label = "BT";
            bindings = <
&ext_power EP_TOG  &trans        &trans        &trans        &trans        &trans          &trans  &trans  &trans  &trans  &trans  &trans
&trans             &out OUT_USB  &out OUT_TOG  &trans        &trans        &trans          &trans  &trans  &trans  &trans  &trans  &trans
&bt BT_CLR         &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4    &trans  &trans  &trans  &trans  &trans  &trans
&trans             &trans        &trans        &trans        &trans        &trans          &trans  &trans  &trans  &trans  &trans  &trans
                                               &trans        &trans        &trans          &trans  &trans
                                                             &trans        &trans          &trans
            >;
        };

        scroll_layer {
            label = "SCROLL";
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
                        &trans  &trans  &trans    &trans  &trans
                                &trans  &trans    &trans
            >;
        };

        fkeys_layer {
            label = "FKEYS";
            bindings = <
&kp F1  &kp F2  &kp F3  &kp F4  &kp F5  &kp F6    &kp F7  &kp F8  &kp F9  &kp F10  &kp F11  &kp F12
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans   &trans   &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans   &trans   &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans   &trans   &trans
                        &trans  &trans  &trans    &trans  &trans
                                &trans  &trans    &trans
            >;
        };

        game_layer {
            label = "GAME";
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans    &trans    &trans    &trans     &trans     &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans    &trans    &trans     &trans     &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans    &trans    &kp UP     &trans     &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans    &kp LEFT  &kp DOWN   &kp RIGHT  &trans  &trans
                        &trans  &kp SPACE  &trans    &trans    &trans
                                &trans     &trans    &trans
            >;
        };

        mouse_layer {
            label = "MOUSE";
            bindings = <
&trans  &trans  &trans    &trans    &trans    &trans      &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans    &mkp MB5  &trans    &trans      &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &mkp MB4  &mkp RCLK &mkp LCLK &mkp MCLK   &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans    &trans    &trans    &trans      &trans  &trans  &trans  &trans  &trans  &trans
                        &trans  &trans  &trans    &trans  &trans
                                &trans  &trans    &trans
            >;
        };
    };
};

/* Auto mouse layer: do not jump into MOUSE if a key was pressed in the last 250 ms
   (ball brushed while typing). No excluded-positions: pressing keys keeps the layer on. */
&zip_temp_layer {
    require-prior-idle-ms = <250>;
};
