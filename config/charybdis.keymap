/*
 * QWERTY adaptation of BastardKB Charybdis 4x6 vendor keymap.
 * Original layout: Copyright 2021 Charly Delay <charly@codesink.dev>.
 * SPDX-License-Identifier: GPL-2.0-or-later
 * https://github.com/Bastardkb/qmk_userspace/tree/main/keyboards/bastardkb/charybdis/4x6/keymaps/vendor
 * See KEYMAP.md for intentional ZMK/Bluetooth adaptations.
 */
#include <behaviors/mouse_keys.dtsi>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/mouse.h>
#include <dt-bindings/zmk/pointing.h>
#include <dt-bindings/zmk/input_transform.h>
#include <input/processors.dtsi>

// 0 BASE, 1 LOWER, 2 RAISE, 3 POINTER, 4 MOUSE_HOLD, 5 SCROLL, 6 SNIPING, 7 SETUP.
// No letter hold-taps, toggle layers, gaming combo, RGB or external-power controls.
/ {
    trackball_listener {
        compatible = "zmk,input-listener";
        device = <&vtrackball>;
        input-processors = <&zip_xy_scaler 9 10>,
                           <&zip_xy_transform (INPUT_TRANSFORM_X_INVERT | INPUT_TRANSFORM_Y_INVERT)>,
                           <&zip_temp_layer 3 700>;
        scroller {
            layers = <5>;
            input-processors = <&zip_x_scaler 0 1>,
                               <&zip_xy_scaler 1 14>,
                               <&zip_xy_to_scroll_mapper>;
        };
        sniper {
            layers = <6>;
            input-processors = <&zip_xy_scaler 3 10>,
                               <&zip_xy_transform (INPUT_TRANSFORM_X_INVERT | INPUT_TRANSFORM_Y_INVERT)>;
        };
    };
    keymap {
        compatible = "zmk,keymap";
        default_layer {
            label = "BASE";
            bindings = <
                &kp ESCAPE  &kp N1  &kp N2  &kp N3  &kp N4  &kp N5  &kp N6  &kp N7  &kp N8  &kp N9  &kp N0  &kp MINUS
                &kp TAB  &kp Q  &kp W  &kp E  &kp R  &kp T  &kp Y  &kp U  &kp I  &kp O  &kp P  &kp BSLH
                &kp LSHFT  &kp A  &kp S  &kp D  &kp F  &kp G  &kp H  &kp J  &kp K  &kp L  &kp SEMI  &kp SQT
                &kp LCTRL  &kp Z  &kp X  &kp C  &kp V  &kp B  &kp N  &kp M  &kp COMMA  &kp DOT  &kp FSLH  &kp LALT
                &kp LGUI  &kp SPACE  &mo 1  &mo 2  &kp RET
                &mo 7  &kp BSPC  &kp DEL
            >;
        };
        lower_layer {
            label = "LOWER";
            bindings = <
                &kp TILDE  &kp EXCL  &kp AT  &kp HASH  &kp DLLR  &kp PRCNT  &kp CARET  &kp AMPS  &kp ASTRK  &kp LPAR  &kp RPAR  &kp UNDER
                &mo 4  &none  &none  &none  &none  &kp KP_NUMLOCK  &kp LBRC  &kp KP_N7  &kp KP_N8  &kp KP_N9  &kp RBRC  &none
                &none  &kp LGUI  &kp LALT  &kp LCTRL  &kp LSHFT  &none  &kp KP_PLUS  &kp KP_N4  &kp KP_N5  &kp KP_N6  &kp KP_MINUS  &kp KP_EQUAL
                &kp LCTRL  &none  &none  &none  &none  &none  &kp KP_MULTIPLY  &kp KP_N1  &kp KP_N2  &kp KP_N3  &kp KP_DIVIDE  &kp LALT
                &kp KP_DOT  &none  &mo 1  &mo 2  &kp RET
                &mo 7  &kp BSPC  &kp KP_N0
            >;
        };
        raise_layer {
            label = "RAISE";
            bindings = <
                &kp F12  &kp F1  &kp F2  &kp F3  &kp F4  &kp F5  &kp F6  &kp F7  &kp F8  &kp F9  &kp F10  &kp F11
                &mo 4  &kp C_NEXT  &none  &none  &none  &none  &none  &none  &none  &none  &kp C_VOL_DN  &kp C_VOL_UP
                &kp C_PP  &kp LEFT  &kp UP  &kp DOWN  &kp RIGHT  &none  &none  &kp RSHFT  &kp RCTRL  &kp RALT  &kp RGUI  &kp C_MUTE
                &kp C_PREV  &kp HOME  &kp PG_UP  &kp PG_DN  &kp END  &none  &none  &none  &none  &none  &none  &kp LALT
                &trans  &trans  &mo 1  &mo 2  &trans
                &mo 7  &trans  &trans
            >;
        };
        pointer_layer {
            label = "POINTER";
            bindings = <
                &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
                &mo 4  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
                &trans  &kp LGUI  &kp LALT  &kp LCTRL  &kp LSHFT  &trans  &trans  &kp RSHFT  &kp RCTRL  &kp RALT  &kp RGUI  &trans
                &trans  &trans  &mo 5  &mo 6  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &kp LALT
                &mkp RCLK  &mkp LCLK  &mo 1  &mo 2  &trans
                &mo 7  &mkp RCLK  &mkp MCLK
            >;
        };
        mouse_hold_layer {
            label = "MOUSE_HOLD";
            bindings = <
                &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
                &mo 4  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
                &trans  &kp LGUI  &kp LALT  &kp LCTRL  &kp LSHFT  &trans  &trans  &kp RSHFT  &kp RCTRL  &kp RALT  &kp RGUI  &trans
                &trans  &trans  &mo 5  &mo 6  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &kp LALT
                &mkp RCLK  &mkp LCLK  &mo 1  &mo 2  &trans
                &mo 7  &mkp RCLK  &mkp MCLK
            >;
        };
        scroll_layer {
            label = "SCROLL";
            bindings = <
                &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
                &mo 4  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
                &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
                &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &kp LALT
                &trans  &trans  &mo 1  &mo 2  &trans
                &mo 7  &trans  &trans
            >;
        };
        sniping_layer {
            label = "SNIPING";
            bindings = <
                &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
                &mo 4  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
                &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
                &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &kp LALT
                &trans  &trans  &mo 1  &mo 2  &trans
                &mo 7  &trans  &trans
            >;
        };
        setup_layer {
            label = "SETUP";
            bindings = <
                &to 0  &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4  &none  &none  &none  &none  &none  &none
                &none  &none  &none  &none  &none  &none  &none  &out OUT_USB  &none  &none  &none  &none
                &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none
                &none  &none  &none  &none  &none  &out OUT_BLE  &none  &none  &none  &none  &none  &none
                &none  &none  &mo 1  &mo 2  &none
                &mo 7  &bt BT_CLR  &none
            >;
        };
    };
};
&zip_temp_layer {
    require-prior-idle-ms = <250>;
    // Mouse actions remain on POINTER; ordinary typing exits the automatic layer.
    // Manual mouse access uses a separate layer so the auto timer cannot clear it.
    excluded-positions = <12 25 26 27 28 31 32 33 34 38 39 47 48 49 54 55>;
};
